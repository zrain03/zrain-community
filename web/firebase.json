{
  "hosting": {
    "site": "zrain-community",
    "public": "public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      {"source":"**", "headers":[
        {"key":"X-Content-Type-Options","value":"nosniff"},
        {"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"}
      ]},
      {"source":"**/*.html", "headers":[{"key":"Cache-Control","value":"public,max-age=0,must-revalidate"}]},
      {"source":"**/*.js", "headers":[{"key":"Cache-Control","value":"public,max-age=0,must-revalidate"}]},
      {"source":"/admin.html", "headers":[
        {"key":"Cache-Control","value":"no-store"},
        {"key":"X-Robots-Tag","value":"noindex,nofollow"}
      ]},
      {"source":"/embed.html", "headers":[{"key":"X-Robots-Tag","value":"noindex,nofollow"}]}
    ]
  }
}
